  "scripts": {
    "build": "lerna run build",
    "lint": "lerna run lint",
    "test": "lerna run test && npm run test-storybook",
    "storybook": "storybook dev -p 6006 --no-open",
    "build-storybook": "npm run build-storybook:root && npm run build-storybook:children && npm run build-storybook:copy",
    "build-storybook:root": "storybook build -o storybook-static",
    "build-storybook:children": "npm run build-storybook -w packages/react-library && npm run build-storybook -w packages/vue-library && npm run build-storybook -w packages/angular-library && npm run build-storybook -w packages/nextjs-app",
    "build-storybook:copy": "cp -r packages/react-library/storybook-static storybook-static/react-vite && cp -r packages/vue-library/storybook-static storybook-static/vue && cp -r packages/angular-library/storybook-static storybook-static/angular && cp -r packages/nextjs-app/storybook-static storybook-static/react-nextjs",
    "test-storybook": "vitest run --project=storybook",
    "storybook:children": "concurrently \"npm run storybook --workspace=packages/react-library\" \"npm run storybook --workspace=packages/vue-library\" \"npm run storybook --workspace=packages/angular-library\" \"npm run storybook --workspace=packages/nextjs-app\"",
    "storybook:composed": "wait-on http://localhost:6007 http://localhost:6008 http://localhost:6009 http://localhost:6010 && storybook dev -p 6006",
    "storybook:all": "concurrently \"npm run storybook:children\" \"npm run storybook:composed\"",
    "serve-storybook": "npm run build && npm run build-storybook && npx serve storybook-static",
    "upgrade-storybook": "npx storybook@latest upgrade"
  },
  "description": "Monorepo for the PID Component and related packages",
  "author": {
